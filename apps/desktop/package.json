{
  "name": "aifisher-desktop",
  "version": "2.1.6",
  "private": true,
  "description": "AIFISHER Windows desktop application.",
  "main": "src/main.mjs",
  "author": "AIFISHER",
  "devDependencies": {
    "electron": "44.3.0"
  },
  "build": {
    "appId": "com.aifisher.desktop",
    "productName": "AIFISHER",
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "afterPack": "build/afterPack.cjs",
    "directories": {
      "output": "../../release/windows"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kjx372124896",
        "repo": "AIFISHER",
        "releaseType": "release"
      }
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../.desktop-package/app",
        "to": "app",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../../public/aifisher-app.ico",
      "artifactName": "AIFISHER-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AIFISHER",
      "uninstallDisplayName": "AIFISHER",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
